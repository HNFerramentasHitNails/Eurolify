#!/usr/bin/env bash
# Comando fixo das chaves dos fluxos do GitHub (ADR-0026, ADR-0028).
# Corre como eurolify-<fluxo>, sem sudo nem docker: só valida o pedido, deixa-o
# na pasta do fluxo e espera pela resposta do serviço da máquina (root).
#
# authorized_keys: restrict,command="/usr/local/bin/eurolify-pedido <fluxo>" <chave>
#
# Cada pedido leva um identificador e a resposta vem em resultado.<id>: um
# pedido nunca lê a resposta de outro que tenha ficado a meio (revisão do #10, P1).
set -Eeuo pipefail
umask 077

fluxo="${1:-}"
pedido="${SSH_ORIGINAL_COMMAND:-}"

case "$fluxo" in
  publicar)
    padrao='^sha256:[0-9a-f]{64}$'
    espera=900
    ;;
  aplicar)
    padrao='^[0-9a-f]{40} (mostrar|aplicar)$'
    espera=1800
    ;;
  medir)
    padrao='^$'
    espera=120
    ;;
  # O comando do operador (docs/19 §6): criar um comerciante, uma chave ou o
  # convite do primeiro dono (§6.0).
  # Espera mais do que a cópia pode durar (eurolify-copia, 1800 s), para o GitHub
  # não dar falha com o comando a correr (revisão do #110, P2-2).
  operar)
    padrao='^(comerciante [a-z]{2} [A-Za-z_]+(/[A-Za-z0-9_+-]+){0,2} [A-Za-z0-9_-]{1,200} run:[0-9]{1,20} github:[0-9]{1,20}|chave [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12} [a-z:,]{1,200} eul_sk_[a-z2-7]{5} [0-9a-f]{64} [A-Za-z0-9_-]{1,200} github:[0-9]{1,20}|convite [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12} [A-Za-z0-9_-]{1,340} dono [0-9a-f]{64} github:[0-9]{1,20})$'
    espera=1900
    maximo=600
    ;;
  # A configuração do e-mail da API (docs/34 §13): os cinco valores em
  # base64, dos segredos do ambiente «ensaio», com a execução e a conta de
  # quem a lançou; ou «teste», o e-mail de teste com o que a API tem (§13.1). Espera pela API recriada, mais do que o serviço (revisão
  # do #398, P3-1).
  configurar)
    padrao='^(smtp [A-Za-z0-9+/]+={0,2}|teste|chave-envios (trocar|tirar-anterior)) run:[0-9]{1,20} github:[0-9]{1,20}$'
    espera=1900
    maximo=1500
    ;;
  *)
    echo "eurolify-pedido: fluxo desconhecido" >&2
    exit 64
    ;;
esac

if [[ ${#pedido} -gt ${maximo:-200} || ! "$pedido" =~ $padrao ]]; then
  echo "eurolify-pedido: pedido recusado para o fluxo '$fluxo'" >&2
  exit 65
fi

pasta="/var/lib/eurolify/pedidos/$fluxo"
cd "$pasta"

# Um pedido de cada vez por fluxo.
exec 9>"$pasta/.tranca"
if ! flock -w 60 9; then
  echo "eurolify-pedido: outro pedido de '$fluxo' ainda está a correr" >&2
  exit 75
fi

# Respostas de pedidos antigos que ninguém leu já não interessam a ninguém.
rm -f resultado.*

id="$(date +%s%N)$$"
printf '%s\n%s\n' "$pedido" "$id" >pedido.tmp
mv -f pedido.tmp pedido

resposta="resultado.$id"
for ((i = 0; i < espera; i++)); do
  if [[ -f "$resposta" ]]; then
    codigo="$(head -n 1 "$resposta")"
    tail -n +2 "$resposta"
    rm -f "$resposta"
    [[ "$codigo" =~ ^[0-9]+$ ]] || codigo=70
    exit "$codigo"
  fi
  sleep 1
done

echo "eurolify-pedido: sem resposta em ${espera} s (o serviço eurolify-pedido@${fluxo} correu?)" >&2
exit 69
