#!/usr/bin/env bash
# Configura o envio de e-mails da API (docs/34 §13; issue #372; Diogo,
# 12/10/2026: «a», a porta própria para a configuração). Corre como root,
# chamado pelo eurolify-trabalho no fluxo «configurar».
#
# O pedido vem pela ENTRADA, nunca como argumento: leva a palavra-passe, e a
# linha de comandos de um processo lê-se no /proc (revisão do #398, P1-1).
# É «smtp <base64> run:<n> github:<conta>»: o base64 traz as cinco linhas
# SMTP_ANFITRIAO, SMTP_PORTA, SMTP_UTILIZADOR, SMTP_PALAVRA_PASSE e
# SMTP_REMETENTE, por esta ordem, vindas dos segredos do ambiente «ensaio» do
# GitHub. Valida cada uma, escreve o /etc/eurolify/api-smtp.env (600, root)
# de uma vez e confirma que a API corre com ele (recria-a com a imagem que
# está no ar, eurolify-publicar --so-recriar, se ainda não).
#
# Nunca escreve os valores na saída nem no registo: só o que aconteceu.
set -Eeuo pipefail
umask 077
export LC_ALL=C
# shellcheck source=../lib/comum.sh
source /usr/local/lib/eurolify/comum.sh

API_SMTP_ENV="${EUROLIFY_API_SMTP_ENV:-/etc/eurolify/api-smtp.env}"

recusar() {
  echo "Configuração recusada: $1. Nada mudou."
  registar "configurar: recusado ($1)"
  exit 65
}

(($# == 0)) || recusar "o pedido vem pela entrada, não como argumento"
pedido=""
IFS= read -r pedido || true
[[ "$pedido" =~ ^smtp\ ([A-Za-z0-9+/]+={0,2})\ run:[0-9]{1,20}\ github:[0-9]{1,20}$ ]] ||
  recusar "o pedido não tem a forma «smtp <base64> run:<n> github:<conta>»"
# O base64 desfaz-se aqui, num processo de root; uma falha não mostra nada dele.
if ! conteudo="$(printf '%s' "${BASH_REMATCH[1]}" | base64 -d 2>/dev/null)"; then
  recusar "os dados não vêm em base64"
fi
linhas=()
while IFS= read -r linha || [[ -n "$linha" ]]; do
  linhas+=("$linha")
done <<<"$conteudo"
[[ ${#linhas[@]} -eq 5 ]] || recusar "vieram ${#linhas[@]} linhas, e não as 5 (anfitrião, porta, utilizador, palavra-passe, remetente)"

anfitriao="${linhas[0]}"
porta="${linhas[1]}"
utilizador="${linhas[2]}"
palavra_passe="${linhas[3]}"
remetente="${linhas[4]}"

# O mesmo endereço simples da API (apps/api/src/notificacoes/correio.ts,
# ENDERECO): nada que vire uma lista de destinatários.
endereco='^[A-Za-z0-9._%+'"'"'-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$'
[[ "$anfitriao" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ ]] || recusar "SMTP_ANFITRIAO não é um nome de servidor"
# A API só usa 465 (TLS logo) e 587 (STARTTLS) (docs/34 §5).
[[ "$porta" =~ ^(465|587)$ ]] || recusar "SMTP_PORTA não é 465 nem 587"
[[ ${#utilizador} -le 254 && "$utilizador" =~ $endereco ]] || recusar "SMTP_UTILIZADOR não é um endereço de e-mail"
[[ ${#remetente} -le 254 && "$remetente" =~ $endereco ]] || recusar "SMTP_REMETENTE não é um endereço de e-mail"
# A palavra-passe vai inteira para o --env-file do docker, que lê a linha até
# ao fim: sem caracteres de controlo e sem espaços nas pontas (o docker e o
# painel da OVH podiam cortá-los). Conta-se em bytes (LC_ALL=C).
[[ ${#palavra_passe} -ge 1 && ${#palavra_passe} -le 256 ]] || recusar "SMTP_PALAVRA_PASSE vazia ou com mais de 256 bytes"
[[ ! "$palavra_passe" =~ [[:cntrl:]] ]] || recusar "SMTP_PALAVRA_PASSE tem caracteres de controlo"
[[ ! "$palavra_passe" =~ ^[[:space:]] && ! "$palavra_passe" =~ [[:space:]]$ ]] || recusar "SMTP_PALAVRA_PASSE começa ou acaba com espaço"

desejado="$(printf 'SMTP_ANFITRIAO=%s\nSMTP_PORTA=%s\nSMTP_UTILIZADOR=%s\nSMTP_PALAVRA_PASSE=%s\nSMTP_REMETENTE=%s' \
  "$anfitriao" "$porta" "$utilizador" "$palavra_passe" "$remetente")"
actual="$(cat "$API_SMTP_ENV" 2>/dev/null || true)"
if [[ -f "$API_SMTP_ENV" && "$actual" == "$desejado" ]]; then
  echo "A configuração do e-mail já era esta: o ficheiro não muda."
  registar "configurar: api-smtp.env sem mudança"
else
  novo="$API_SMTP_ENV.novo"
  rm -f -- "$novo"
  printf '%s\n' "$desejado" >"$novo"
  chown root:root "$novo"
  chmod 600 "$novo"
  mv -fT "$novo" "$API_SMTP_ENV"
  echo "Configuração do e-mail escrita em $API_SMTP_ENV (5 variáveis; os valores não se mostram)."
  registar "configurar: api-smtp.env escrito (5 variáveis)"
fi

# A API só lê o --env-file ao ser criada. Confere-se sempre, também quando o
# ficheiro não mudou: uma corrida anterior pode ter escrito o ficheiro sem a
# API se recriar (revisão do #398, P2-1), e lançar a acção outra vez resolve.
carregar_config
# A API corre com estes valores: as cinco linhas estão no ambiente do
# contentor. Compara-se em memória, sem mostrar nada; as datas não bastavam,
# porque uma publicação a meio pode criar o contentor depois da escrita mas
# com a lista dos ficheiros lida antes (revisão do #398, P2-1).
le_o_ficheiro() {
  local ambiente linha
  ambiente="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' eurolify-api 2>/dev/null)" || return 1
  while IFS= read -r linha; do
    grep -qxF -- "$linha" <<<"$ambiente" || return 1
  done <<<"$desejado"
}

imagem_api="$(docker inspect -f '{{.Config.Image}}' eurolify-api 2>/dev/null || true)"
resumo_api="${imagem_api##*@}"
if [[ -z "$imagem_api" ]]; then
  echo "Sem contentor eurolify-api: a próxima publicação já lê a configuração."
  exit 0
fi
# O eurolify-publicar só recria a imagem do IMAGEM_REPO desta máquina, como
# no passo 10c do preparar.sh (revisão do #180, P3-1).
if [[ "${imagem_api%@*}" != "${IMAGEM_REPO:-}" || ! "$resumo_api" =~ ^sha256:[0-9a-f]{64}$ ]]; then
  echo "ATENÇÃO: o eurolify-api corre $imagem_api, que não é uma imagem de $IMAGEM_REPO com resumo: não o recrio (a próxima publicação recria-o)."
  registar "configurar: a API não se recriou (imagem de outro repositório ou sem resumo)"
  exit 1
fi
if le_o_ficheiro; then
  echo "A API já corre com esta configuração do e-mail."
  exit 0
fi
if ! /usr/local/sbin/eurolify-publicar "$resumo_api" --so-recriar; then
  # O --so-recriar também falha pelo MCP ou pelo Hub (revisão do #398, P3-5).
  registar "configurar: a recriação falhou"
  echo "ATENÇÃO: a recriação falhou (a API, o MCP ou o Hub; ver acima)."
  exit 1
fi
if le_o_ficheiro; then
  echo "A API recriou-se e corre com a configuração do e-mail."
else
  registar "configurar: a API não se recriou com a configuração do e-mail"
  echo "ATENÇÃO: a API não se recriou com a configuração do e-mail (outra publicação pode ter trocado a imagem entretanto). Lance a acção outra vez."
  exit 1
fi
