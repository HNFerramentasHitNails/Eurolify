#!/usr/bin/env bash
# Verificação diária da VPS (ADR-0027): o que pára em silêncio. Se houver
# problemas, avisa o Healthchecks.io como «falhou», com a lista.
set -uo pipefail
# shellcheck source=../lib/comum.sh
source /usr/local/lib/eurolify/comum.sh
carregar_config

problemas=()
hoje="$(date -u +%F)"

uso="$(df --output=pcent / | tail -n 1 | tr -dc '0-9')"
((uso > 80)) && problemas+=("disco a ${uso}% (limite 80%)")

total="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
livre="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)"
((livre * 100 / total < 10)) && problemas+=("memória disponível abaixo de 10% (sem swap, ADR-0021)")

for s in ssh docker fail2ban; do
  systemctl is-active --quiet "$s" || problemas+=("serviço $s parado")
done
estado_ufw="$(ufw status 2>&1)"
[[ "$estado_ufw" == *"Status: active"* ]] || problemas+=("firewall (ufw) desligada")

[[ "$(docker inspect -f '{{.State.Running}}' eurolify-postgres 2>/dev/null)" == true ]] ||
  problemas+=("contentor eurolify-postgres parado")
if docker inspect eurolify-api >/dev/null 2>&1; then
  curl -fsS -m 5 http://127.0.0.1:8080/health >/dev/null 2>&1 || problemas+=("a API não responde no /health")
fi

# A limpeza diária da idempotência (eurolify-limpeza, 05:00) corre? A unidade
# falhada avisa logo (revisão do #119, P2-1); uma linha expirada há mais de um
# dia avisa também se o temporizador parou. A leitura entra como o papel da
# limpeza, não como o superutilizador (migração 0013).
if systemctl is-failed --quiet eurolify-limpeza.service 2>/dev/null; then
  problemas+=("a limpeza da idempotência falhou na última corrida (journalctl -u eurolify-limpeza)")
fi
if [[ "$(docker inspect -f '{{.State.Running}}' eurolify-postgres 2>/dev/null)" == true ]]; then
  if ! existe="$(docker exec eurolify-postgres psql -U eurolify_limpeza -d "$BASE_NOME" -qAtc \
    "select to_regclass('public.idempotencia') is not null" 2>&1)"; then
    problemas+=("não consegui entrar na base como eurolify_limpeza (preparar.sh, passo 10b): $(head -n 1 <<<"$existe")")
  elif [[ "$existe" == t ]]; then
    if atrasadas="$(docker exec eurolify-postgres psql -U eurolify_limpeza -d "$BASE_NOME" -qAtc \
      "select count(*) from idempotencia where expira_em < now() - interval '1 day'" 2>&1)"; then
      [[ "$atrasadas" =~ ^[0-9]+$ ]] && ((atrasadas > 0)) &&
        problemas+=("$atrasadas linha(s) da idempotência expiradas há mais de um dia: a limpeza diária (eurolify-limpeza) não está a correr")
    else
      problemas+=("não consegui contar as linhas da idempotência: $(head -n 1 <<<"$atrasadas")")
    fi
  fi
  # Sem a tabela (migração 0012 por publicar) não há nada a limpar.
fi

seguranca="$(/usr/lib/update-notifier/apt-check 2>&1 | cut -d ';' -f 2)"
[[ "$seguranca" =~ ^[0-9]+$ ]] && ((seguranca > 0)) &&
  problemas+=("$seguranca actualizações de segurança por aplicar")
[[ -f /var/run/reboot-required ]] &&
  problemas+=("reinício pedido pelas actualizações — fazer fora do horário de trabalho e anunciado (AGENTS.md)")

# Datas escritas nas decisões. Avisam todos os dias até se mudar este ficheiro.
[[ ! "$hoje" < "2027-03-01" ]] &&
  problemas+=("ADR-0019: a VPS no Reino Unido acaba a 31/03/2027 — migrar para Paris")
[[ ! "$hoje" < "2026-10-28" ]] &&
  problemas+=("ADR-0025: o Node 26 é LTS desde 28/10/2026 — passar a imagem para o 26")

if [[ -r /etc/eurolify/ghcr.expira ]]; then
  expira="$(tr -dc '0-9-' </etc/eurolify/ghcr.expira)"
  if [[ ! "$expira" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || ! fim="$(date -u -d "$expira" +%s 2>/dev/null)"; then
    problemas+=("/etc/eurolify/ghcr.expira não tem uma data AAAA-MM-DD válida")
  elif ((fim - $(date -u +%s) < 14 * 86400)); then
    problemas+=("o token do GHCR expira a $expira — criar outro (ADR-0026)")
  fi
else
  problemas+=("falta /etc/eurolify/ghcr.expira (data de fim do token do GHCR)")
fi

# MCP (ADR-0033): a chave da OVH do certificado troca-se a uma data escrita, e
# o certificado tem de se ir renovando (o certbot renova aos 30 dias do fim).
if [[ -r /etc/eurolify/ovh-dns.expira ]]; then
  troca="$(tr -dc '0-9-' </etc/eurolify/ovh-dns.expira)"
  if [[ ! "$troca" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || ! fim_ovh="$(date -u -d "$troca" +%s 2>/dev/null)"; then
    problemas+=("/etc/eurolify/ovh-dns.expira não tem uma data AAAA-MM-DD válida")
  elif ((fim_ovh - $(date -u +%s) < 14 * 86400)); then
    problemas+=("a chave da API da OVH (certificado do MCP) troca-se a $troca — criar outra (ADR-0033)")
  fi
fi
certificado="/etc/letsencrypt/live/${MCP_DOMINIO:-mcp.eurolify.eu}/fullchain.pem"
if [[ -r "$certificado" ]]; then
  if ! openssl x509 -checkend $((20 * 86400)) -noout -in "$certificado" >/dev/null 2>&1; then
    problemas+=("o certificado de ${MCP_DOMINIO:-mcp.eurolify.eu} expira em menos de 20 dias — a renovação do certbot falhou?")
  fi
  systemctl is-active --quiet nginx || problemas+=("serviço nginx parado (MCP)")
  if docker inspect eurolify-mcp >/dev/null 2>&1; then
    curl -fsS -m 5 http://127.0.0.1:8090/health >/dev/null 2>&1 || problemas+=("o MCP não responde no /health")
  fi
fi

if ((${#problemas[@]})); then
  texto="$(printf -- '- %s\n' "${problemas[@]}")"
  echo "$texto"
  hc VERIFICACAO falhou "$texto"
  exit 1
fi
echo "Sem problemas."
hc VERIFICACAO ok "sem problemas"
