#!/usr/bin/env bash
# Cópia diária da base do ensaio (ADR-0027): pg_dump, cifrado com age, enviado
# para o OVH Object Storage (ADR-0032). Apaga lá as cópias com mais de 14 dias
# (ADR-0027). Avisa o Healthchecks.io do resultado.
set -Eeuo pipefail
# shellcheck source=../lib/comum.sh
source /usr/local/lib/eurolify/comum.sh
carregar_config

# Qualquer saída com erro (comando falhado ou falhar) avisa: nunca em silêncio.
terminar() {
  local codigo=$?
  ((codigo == 0)) || hc COPIA falhou "a cópia falhou (código $codigo); ver journalctl -u eurolify-copia"
}
trap terminar EXIT

[[ -s /etc/eurolify/age.pub ]] || falhar "falta /etc/eurolify/age.pub"
[[ -s /etc/eurolify/rclone.conf ]] || falhar "falta /etc/eurolify/rclone.conf"

pasta=/var/lib/eurolify/copias
install -d -m 700 "$pasta"
carimbo="$(date -u +%Y%m%dT%H%M%SZ)"
nome="eurolify-${carimbo}.dump.age"

docker exec eurolify-postgres pg_dump -U postgres -Fc "$BASE_NOME" |
  age -R /etc/eurolify/age.pub -o "$pasta/$nome"

rclone --config /etc/eurolify/rclone.conf copyto "$pasta/$nome" "$S3_DESTINO/$nome"

# Na máquina ficam só as cópias cifradas dos últimos 2 dias.
find "$pasta" -type f -name 'eurolify-*.dump.age' -mtime +2 -delete

# Na OVH, 14 dias (ADR-0027) garantidos por nós, não só pela regra do
# contentor (revisão do #15, P1): apaga as cópias com mais de 14 dias.
rclone --config /etc/eurolify/rclone.conf delete --min-age 14d \
  --include 'eurolify-*.dump.age' "$S3_DESTINO"

# As imagens dos artigos (docs/06, CQ), também cifradas e com os mesmos 14
# dias. Sem a pasta (antes do passo 7 do preparar.sh), não há o que copiar.
if [[ -d /var/lib/eurolify/media ]]; then
  nome_media="eurolify-media-${carimbo}.tar.age"
  tar -C /var/lib/eurolify -cf - media | age -R /etc/eurolify/age.pub -o "$pasta/$nome_media"
  rclone --config /etc/eurolify/rclone.conf copyto "$pasta/$nome_media" "$S3_DESTINO/$nome_media"
  find "$pasta" -type f -name 'eurolify-media-*.tar.age' -mtime +2 -delete
  rclone --config /etc/eurolify/rclone.conf delete --min-age 14d \
    --include 'eurolify-media-*.tar.age' "$S3_DESTINO"
fi

tamanho="$(du -h "$pasta/$nome" | cut -f1)"
registar "cópia $nome enviada ($tamanho)"
hc COPIA ok "cópia $nome ($tamanho)"
