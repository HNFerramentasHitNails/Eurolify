#!/usr/bin/env bash
# Serviço da máquina que trata um pedido dos fluxos (ADR-0026, ADR-0028).
# Corre como root, lançado pelo eurolify-pedido@<fluxo>.path quando aparece
# /var/lib/eurolify/pedidos/<fluxo>/pedido. A pasta é do utilizador do fluxo:
# nada do que lá está é de confiança — valida-se tudo outra vez.
#
# O pedido tem duas linhas: o comando e o identificador; a resposta vai para
# resultado.<identificador>. No fluxo «mcp» há uma terceira: o número da conta
# no GitHub de quem pediu, que vai para o registo (ADR-0033, ponto 7;
# auditoria docs/16). Só o número, sem o nome. É o MCP que o diz: prova o que
# a sessão OAuth do MCP aceitou, não mais.
set -Eeuo pipefail
umask 077
# shellcheck source=../lib/comum.sh
source /usr/local/lib/eurolify/comum.sh

fluxo="${1:-}"
case "$fluxo" in
  publicar) padrao='^sha256:[0-9a-f]{64}$' ;;
  aplicar) padrao='^[0-9a-f]{40} (mostrar|aplicar)$' ;;
  medir) padrao='^$' ;;
  # O MCP da VPS (ADR-0033): a lista fixa de leituras e operações.
  mcp) padrao='^(medir|publicacoes|copia|reposicao|reiniciar-api|actualizar|reiniciar-vps|publicar sha256:[0-9a-f]{64})$' ;;
  # O comando do operador (docs/19 §6); o mesmo formato do eurolify-pedido.
  operar) padrao='^(comerciante [a-z]{2} [A-Za-z_]+(/[A-Za-z0-9_+-]+){0,2} [A-Za-z0-9_-]{1,200} run:[0-9]{1,20} github:[0-9]{1,20}|chave [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12} [a-z:,]{1,200} eul_sk_[a-z2-7]{5} [0-9a-f]{64} [A-Za-z0-9_-]{1,200} github:[0-9]{1,20}|convite [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12} [A-Za-z0-9_-]{1,340} dono [0-9a-f]{64} github:[0-9]{1,20})$' ;;
  # A configuração do e-mail (docs/34 §13); o mesmo formato do eurolify-pedido.
  configurar) padrao='^(smtp [A-Za-z0-9+/]+={0,2}|teste|chave-envios (trocar|tirar-anterior)) run:[0-9]{1,20} github:[0-9]{1,20}$' ;;
  *) falhar "fluxo desconhecido: '$fluxo'" ;;
esac

pasta="/var/lib/eurolify/pedidos/$fluxo"
utilizador="eurolify-$fluxo"
trabalho=/var/lib/eurolify/trabalho
install -d -m 700 "$trabalho"

[[ -e "$pasta/pedido" || -L "$pasta/pedido" ]] || exit 0

# Tira o pedido da pasta do utilizador para uma de root, sem seguir ligações.
# Se não se conseguir (ex.: uma pasta com esse nome), apaga-se: senão o .path
# voltava a disparar até ao limite e o fluxo ficava parado.
recebido="$(mktemp "$trabalho/pedido.XXXXXX")"
trap 'rm -f "$recebido"' EXIT
if ! mv -fT "$pasta/pedido" "$recebido" 2>/dev/null; then
  rm -rf -- "${pasta:?}/pedido"
  registar "fluxo $fluxo: pedido que não se pôde retirar foi apagado"
  exit 1
fi
if [[ -L "$recebido" || ! -f "$recebido" ]]; then
  registar "fluxo $fluxo: pedido recusado (não é um ficheiro normal)"
  exit 1
fi
# O pedido do operador pode ter até 600 caracteres; os outros, 200.
limite=200
[[ "$fluxo" == operar ]] && limite=600
[[ "$fluxo" == configurar ]] && limite=1500
pedido="$(head -c $((limite + 100)) -- "$recebido" | sed -n 1p)"
id="$(head -c $((limite + 100)) -- "$recebido" | sed -n 2p)"
conta="$(head -c $((limite + 100)) -- "$recebido" | sed -n 3p)"

# Sem um identificador válido não há a quem responder.
if [[ ! "$id" =~ ^[0-9]{10,40}$ ]]; then
  registar "fluxo $fluxo: pedido recusado (identificador inválido)"
  exit 1
fi

# Uma conta que não é um número não entra no registo. Sem conta (uma imagem
# do MCP anterior a esta), regista-se que não veio. Esta rede serve para se
# poder voltar a uma imagem antiga (voltar_a_publicacao); sai quando nenhuma
# das publicações a que se pode voltar (publicacoes.log) for anterior ao #102.
# Teste: infra/vps/testes/trabalho-conta.sh.
origem_mcp="mcp, conta não indicada"
conta_invalida=0
if [[ "$fluxo" == mcp && -n "$conta" ]]; then
  if [[ "$conta" =~ ^[0-9]{1,20}$ ]]; then
    origem_mcp="mcp, conta $conta"
  else
    conta_invalida=1
  fi
fi

saida="$(mktemp "$trabalho/saida.XXXXXX")"
trap 'rm -f "$recebido" "$saida"' EXIT
codigo=0
if [[ ${#pedido} -gt $limite || ! "$pedido" =~ $padrao || $conta_invalida -eq 1 ]]; then
  # O conteúdo recusado não vai para o registo nem volta ao cliente.
  echo "Pedido recusado pelo serviço da máquina." >"$saida"
  codigo=65
  EUROLIFY_ORIGEM="fluxo $fluxo" registar "fluxo $fluxo: pedido $id recusado (formato inválido)"
else
  case "$fluxo" in
    publicar)
      EUROLIFY_ORIGEM="fluxo publicar" /usr/local/sbin/eurolify-publicar "$pedido" >"$saida" 2>&1 || codigo=$?
      ;;
    aplicar)
      read -r commit modo <<<"$pedido"
      EUROLIFY_ORIGEM="fluxo aplicar-script, commit $commit" \
        /usr/local/sbin/eurolify-aplicar "$commit" "$modo" >"$saida" 2>&1 || codigo=$?
      ;;
    medir)
      /usr/local/sbin/eurolify-medir >"$saida" 2>&1 || codigo=$?
      ;;
    mcp)
      EUROLIFY_ORIGEM="$origem_mcp" /usr/local/sbin/eurolify-operar "$pedido" >"$saida" 2>&1 || codigo=$?
      ;;
    operar)
      EUROLIFY_ORIGEM="fluxo operar, conta ${pedido##*github:}" /usr/local/sbin/eurolify-operador "$pedido" >"$saida" 2>&1 || codigo=$?
      ;;
    configurar)
      # O pedido leva a palavra-passe: vai pela entrada, nunca na linha de
      # comandos, que qualquer conta lê no /proc (revisão do #398, P1-1).
      EUROLIFY_ORIGEM="fluxo configurar, conta ${pedido##*github:}" \
        /usr/local/sbin/eurolify-configurar <<<"$pedido" >"$saida" 2>&1 || codigo=$?
      ;;
  esac
  if [[ "$fluxo" == mcp ]]; then
    EUROLIFY_ORIGEM="fluxo mcp, ${origem_mcp#mcp, }" registar "pedido $id '$pedido' tratado, código $codigo"
  elif [[ "$fluxo" == configurar ]]; then
    # Nunca o pedido: leva a palavra-passe. Só a acção (smtp ou teste).
    EUROLIFY_ORIGEM="fluxo configurar, conta ${pedido##*github:}" registar "pedido $id '${pedido%% *}' (${pedido##* run:}) tratado, código $codigo"
  elif [[ "$fluxo" == operar ]]; then
    # Só a acção: o resto do pedido leva o nome de um comerciante.
    EUROLIFY_ORIGEM="fluxo operar, conta ${pedido##*github:}" registar "pedido $id '${pedido%% *}' tratado, código $codigo"
  else
    EUROLIFY_ORIGEM="fluxo $fluxo" registar "pedido $id '${pedido:-(vazio)}' tratado, código $codigo"
  fi
fi

# Respostas que ninguém veio buscar (quem pediu desistiu de esperar) saem ao
# fim de uma hora. Só ficheiros: uma ligação com esse nome não é seguida.
find "$pasta" -maxdepth 1 -type f -name 'resultado.*' -mmin +60 -delete 2>/dev/null || true

# A resposta escreve-se numa pasta de root e entra com um rename: se o
# utilizador deixar uma ligação com esse nome, é substituída, não seguida.
resposta="$(mktemp "$trabalho/resposta.XXXXXX")"
{
  echo "$codigo"
  filtrar_ip <"$saida"
} >"$resposta"
chown "$utilizador:" "$resposta"
chmod 600 "$resposta"
mv -fT "$resposta" "$pasta/resultado.$id"
