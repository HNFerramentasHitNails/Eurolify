#!/usr/bin/env bash
# Medição fixa da VPS, só leitura (ADR-0028): a secção «migrações» lança até
# dois contentores descartáveis da imagem no ar, sem rede nem capacidades, só
# para ler a lista (#120, P3-4). Corre como root, chamado pelo
# eurolify-trabalho, que ainda tira os endereços IP da saída. Mudar a lista é
# mudar este ficheiro, por pedido de alteração revisto.
set -uo pipefail

seccao() { printf '\n## %s\n' "$1"; }

seccao "data (UTC)"
date -u +%FT%TZ

seccao "sistema"
grep -E '^PRETTY_NAME=' /etc/os-release
echo "kernel $(uname -r), $(nproc) núcleos"
free -h
df -h /

seccao "serviços"
for s in ssh docker fail2ban ufw nginx eurolify-copia.timer eurolify-reposicao.timer eurolify-verificacao.timer eurolify-limpeza.timer \
  eurolify-pedido@publicar.path eurolify-pedido@aplicar.path eurolify-pedido@medir.path eurolify-pedido@mcp.path; do
  printf '%s: %s\n' "$s" "$(systemctl is-active "$s" 2>/dev/null)"
done

seccao "tarefas (última vez)"
for t in copia reposicao verificacao limpeza; do
  printf '%s: %s, resultado %s, fim %s\n' "$t" \
    "$(systemctl show "eurolify-$t.service" -p ActiveState --value 2>/dev/null)" \
    "$(systemctl show "eurolify-$t.service" -p Result --value 2>/dev/null)" \
    "$(systemctl show "eurolify-$t.service" -p ExecMainExitTimestamp --value 2>/dev/null)"
done

# O que a verificação diária encontrou na última vez: a secção de cima só diz
# «failed». São as linhas da lista que o eurolify-verificacao escreve («- …»
# ou «Sem problemas.»): só o estado da máquina, sem dados de pessoas. Pela
# invocação da última corrida; sem ela (depois de reiniciar a máquina), as
# últimas 26 h, só a partir do último arranque da unidade nelas, para não
# juntar duas corridas (revisão do #428, P3-1).
seccao "verificação diária (o que encontrou na última vez)"
if [[ "$(systemctl show eurolify-verificacao.service -p ActiveState --value 2>/dev/null)" == activating ]]; then
  # A corrida em curso ainda não escreveu a lista (revisão do #428, P3-2).
  echo "a verificação está a correr agora; medir outra vez daqui a uns minutos"
else
  invocacao="$(systemctl show eurolify-verificacao.service -p InvocationID --value 2>/dev/null)"
  if [[ "$invocacao" =~ ^[0-9a-f]{32}$ ]]; then
    diario="$(journalctl --no-pager -o cat "_SYSTEMD_INVOCATION_ID=$invocacao" 2>/dev/null)"
  else
    diario="$(journalctl --no-pager -o cat -u eurolify-verificacao.service --since "-26 hours" 2>/dev/null |
      awk '/^Starting eurolify-verificacao/ { n = 0; next } { l[n++] = $0 } END { for (i = 0; i < n; i++) print l[i] }')"
  fi
  linhas="$(grep -E '^(- |Sem problemas\.$)' <<<"$diario" | head -n 40)"
  if [[ -n "$linhas" ]]; then
    printf '%s\n' "$linhas"
  else
    echo "sem registo da última verificação"
  fi
fi

seccao "contentores"
docker ps --all --format '{{.Names}}  {{.Status}}  {{.Image}}' 2>&1
docker stats --no-stream --format '{{.Name}}  {{.MemUsage}}' 2>&1

seccao "portas à escuta"
# Sem endereços (o filtro tirava-os todos e a secção saía vazia): diz só se a
# porta está presa a esta máquina ou aberta, e que programa a tem.
ss -tlnpH | awk '{
  n = split($4, p, ":"); porta = p[n]; endereco = substr($4, 1, length($4) - length(porta) - 1)
  if (endereco ~ /^(127\.|\[::1\])/) onde = "só nesta máquina"
  else if (endereco ~ /^(0\.0\.0\.0|\*|\[::\])$/) onde = "aberta (todas as interfaces)"
  else onde = "presa a um endereço"
  prog = "?"; if (match($0, /\(\("[^"]+"/)) prog = substr($0, RSTART + 3, RLENGTH - 4)
  printf "%s/tcp  %s  %s\n", porta, onde, prog
}' | sort -u | sort -t/ -k1,1n

seccao "ssh"
sshd -T 2>/dev/null | grep -E '^(passwordauthentication|kbdinteractiveauthentication|permitrootlogin|pubkeyauthentication) '

seccao "firewall"
ufw status verbose

seccao "fail2ban (só números)"
fail2ban-client status sshd 2>&1 | grep -E 'Currently|Total'
echo "bantime (sshd): $(fail2ban-client get sshd bantime 2>&1)"
echo "dbpurgeage: $(fail2ban-client get dbpurgeage 2>&1)"

seccao "MCP (ADR-0033)"
for c in /etc/letsencrypt/live/*/fullchain.pem; do
  [[ -r "$c" ]] && echo "certificado $(basename "$(dirname "$c")"): $(openssl x509 -enddate -noout -in "$c")"
done
[[ -r /etc/eurolify/ovh-dns.expira ]] && echo "chave da OVH (certificado) troca-se a: $(cat /etc/eurolify/ovh-dns.expira)"
curl -fsS -m 5 http://127.0.0.1:8090/health 2>/dev/null && echo || echo "MCP: /health sem resposta"

seccao "saída para o VIES (docs/23 §13)"
# Antes de ligar o VIES_URL (revisão do #244, P2-5): a máquina chega à API
# REST da Comissão? Só o estado do serviço, sem NIF nenhum. Mede-se a partir da
# máquina, não do contentor da API (outra rede e outros certificados): a prova
# final é a primeira consulta da fila depois de ligar (revisão do #377, P2-1).
if resposta="$(LC_ALL=C curl -sS -m 10 -w '\nHTTP %{http_code} em %{time_total} s' \
  https://ec.europa.eu/taxation_customs/vies/rest-api/check-status 2>/dev/null)"; then
  ultima="${resposta##*$'\n'}"
  echo "a partir da máquina (não do contentor da API): $ultima"
  if [[ "$ultima" == "HTTP 200 "* ]] &&
    grep -Eq '"available"[[:space:]]*:[[:space:]]*true' <<<"$resposta"; then
    echo "VIES: disponível"
  else
    echo "VIES: responde, mas não diz que está disponível"
  fi
else
  # O código do curl diz a causa (revisão do #377, P2-2): 6 nome, 7 ligação,
  # 28 tempo esgotado, 35 ou 60 TLS.
  echo "VIES: sem resposta (código do curl $?)"
fi
# O endereço vem do api-vies.env (passo 10c do preparar.sh) ou, antes dele, do
# api.env; os dois chegam à API.
if grep -qsE '^VIES_URL=[[:space:]]*[^[:space:]]' /etc/eurolify/api-vies.env /etc/eurolify/api.env; then
  echo "VIES_URL na configuração da API: sim (a API só o lê quando é recriada)"
else
  echo "VIES_URL na configuração da API: não (a consulta está desligada)"
fi
if grep -qs 'check-vat-test-service' /etc/eurolify/api-vies.env /etc/eurolify/api.env; then
  echo "VIES: o serviço de teste da Comissão (sem dados reais)"
fi
# A API leu-o? Só se diz se a variável está no contentor, nunca o valor
# (revisão do #405, P3-2).
if docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' eurolify-api 2>/dev/null |
  grep -qE '^VIES_URL=[^[:space:]]'; then
  echo "VIES_URL na API no ar: sim"
else
  echo "VIES_URL na API no ar: não"
fi

seccao "envios (docs/36 §17)"
# A chave chegou ao contentor da API? Só sim ou não, nunca o valor. O
# eurolify-publicar só passa uma chave válida (docs/36 §17.3).
if docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' eurolify-api 2>/dev/null |
  grep -qE '^ENVIOS_CHAVE=.'; then
  echo "ENVIOS_CHAVE na API no ar: sim (a variável está no contentor)"
else
  echo "ENVIOS_CHAVE na API no ar: não (os envios estão desligados)"
fi
# A troca da chave (docs/36 §25.7): se a anterior está no contentor, e
# quantas contas há em cada versão (só números e versões, nunca uma chave).
if docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' eurolify-api 2>/dev/null |
  grep -qE '^ENVIOS_CHAVE_ANTERIOR=.'; then
  echo "ENVIOS_CHAVE_ANTERIOR na API no ar: sim (troca da chave a meio)"
else
  echo "ENVIOS_CHAVE_ANTERIOR na API no ar: não"
fi
# O nome da base vem do ensaio.conf, que esta medição só lê mais abaixo.
base_envios="$(sed -n 's/^BASE_NOME=//p' /etc/eurolify/ensaio.conf 2>/dev/null | tr -d '"' | head -n 1)"
[[ "$base_envios" =~ ^[a-z_][a-z0-9_]{0,62}$ ]] || base_envios=eurolify
versoes="$(docker exec eurolify-postgres psql -U postgres -d "$base_envios" -qAtc \
  "select coalesce(string_agg(v || ': ' || n, ', ' order by v), 'nenhuma') from (select chave_versao as v, count(*) as n from public.conta_transportadora where chave_versao is not null group by chave_versao) x" 2>/dev/null)" ||
  versoes="(a base não respondeu)"
echo "Contas de transportadora por versão da chave: $versoes"
# Os avisos pelo nginx do Hub, a partir da própria máquina e sem assinatura:
# o POST da Sendcloud chega à API (401 em application/problem+json); o GET
# leva 403 do nginx (limit_except) e o resto de /webhooks/ 404 do nginx, em
# HTML. Uma conta que não existe, sem dados nenhuns: a API responde-lhe como
# a uma assinatura errada, sem gravar nada (envios/rotas.ts). Nunca por um
# proxy: com --noproxy e --resolve, o pedido não sai da máquina. Do corpo da
# resposta não se mostra nada.
aviso() {
  local metodo="$1" caminho="$2" r
  r="$(curl -sS -m 5 -o /dev/null -w '%{http_code} %{content_type}' -X "$metodo" \
    --noproxy '*' --resolve hub.eurolify.eu:443:127.0.0.1 \
    -H 'content-type: application/json' ${3:+--data "$3"} \
    "https://hub.eurolify.eu${caminho}" 2>/dev/null)" || r="sem resposta (código do curl $?)"
  echo "$metodo $caminho: $r"
}
CONTA_FICTICIA="cac_00000000-0000-4000-8000-000000000000"
aviso POST "/webhooks/carriers/sendcloud/${CONTA_FICTICIA}" '{}'
aviso GET "/webhooks/carriers/sendcloud/${CONTA_FICTICIA}"
aviso POST "/webhooks/carriers/ctt/${CONTA_FICTICIA}" '{}'
aviso POST "/webhooks/payments/x" '{}'

seccao "actualizações"
/usr/lib/update-notifier/apt-check --human-readable 2>&1
[[ -f /var/run/reboot-required ]] && echo "Reinício pedido pelas actualizações."

seccao "últimas publicações"
tail -n 5 /var/log/eurolify/publicacoes.log 2>/dev/null || echo "(nenhuma)"

seccao "migrações (base e versão no ar)"
# Sempre à vista, enquanto durar: a base à frente da versão no ar depois de
# voltar a uma publicação (tarefa #113; revisão do #115, P2-2).
if [[ -r /usr/local/lib/eurolify/comum.sh && -r /etc/eurolify/ensaio.conf ]]; then
  # shellcheck source=../lib/comum.sh
  source /usr/local/lib/eurolify/comum.sh
  # shellcheck source=/dev/null
  source /etc/eurolify/ensaio.conf
  mostrar_migracoes() {
    local no_ar da_base da_imagem="" rc=0 a_mais faltam
    no_ar="$(docker inspect --format '{{.Config.Image}}' eurolify-api 2>/dev/null)"
    [[ -n "$no_ar" ]] || { echo "sem a API no ar"; return; }
    da_base="$(migracoes_da_base)" || { echo "a base não respondeu"; return; }
    # Uma versão sem migrador não tem migrações: lista vazia, e a base à
    # frente vê-se na mesma (4.ª revisão do #115, P3-2).
    tem_migrador "$no_ar" || rc=$?
    if ((rc == 2)) || { ((rc == 0)) && ! da_imagem="$(migracoes_da_imagem "$no_ar")"; }; then
      echo "não se leu a lista de migrações da versão no ar"
      return
    fi
    echo "na base: $(printf '%s\n' "$da_base" | sed '/^$/d' | wc -l) (última: $(printf '%s\n' "$da_base" | tail -n 1))"
    echo "na versão no ar: $(printf '%s\n' "$da_imagem" | sed '/^$/d' | wc -l) (última: $(printf '%s\n' "$da_imagem" | tail -n 1))"
    a_mais="$(so_na_primeira "$da_base" "$da_imagem")"
    faltam="$(so_na_primeira "$da_imagem" "$da_base")"
    echo "na base e não na versão no ar: $(if [[ -n "$a_mais" ]]; then virgulas "$a_mais"; else echo nenhuma; fi)"
    echo "na versão no ar e não na base: $(if [[ -n "$faltam" ]]; then virgulas "$faltam"; else echo nenhuma; fi)"
  }
  mostrar_migracoes
else
  echo "(sem a configuração da máquina)"
fi

seccao "últimas acções registadas"
# A conta de quem pediu fica na máquina: esta saída vai para o MCP e para o
# GitHub Actions (revisão do #102, P2-1).
{ tail -n 15 /var/log/eurolify/acoes.log 2>/dev/null || echo "(nenhuma)"; } |
  sed -E 's/conta [0-9]+/conta <n>/g'

exit 0
