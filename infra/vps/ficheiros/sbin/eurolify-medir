#!/usr/bin/env bash
# Medição fixa da VPS, só leitura (ADR-0028): a secção «migrações» lança até
# dois contentores descartáveis da imagem no ar, sem rede nem capacidades, só
# para ler a lista (#120, P3-4). Corre como root, chamado pelo
# eurolify-trabalho, que ainda tira os endereços IP da saída. Mudar a lista é
# mudar este ficheiro, por pedido de alteração revisto.
set -uo pipefail

seccao() { printf '\n## %s\n' "$1"; }

seccao "data (UTC)"
date -u +%FT%TZ

seccao "sistema"
grep -E '^PRETTY_NAME=' /etc/os-release
echo "kernel $(uname -r), $(nproc) núcleos"
free -h
df -h /

seccao "serviços"
for s in ssh docker fail2ban ufw nginx eurolify-copia.timer eurolify-reposicao.timer eurolify-verificacao.timer eurolify-limpeza.timer \
  eurolify-pedido@publicar.path eurolify-pedido@aplicar.path eurolify-pedido@medir.path eurolify-pedido@mcp.path; do
  printf '%s: %s\n' "$s" "$(systemctl is-active "$s" 2>/dev/null)"
done

seccao "tarefas (última vez)"
for t in copia reposicao verificacao limpeza; do
  printf '%s: %s, resultado %s, fim %s\n' "$t" \
    "$(systemctl show "eurolify-$t.service" -p ActiveState --value 2>/dev/null)" \
    "$(systemctl show "eurolify-$t.service" -p Result --value 2>/dev/null)" \
    "$(systemctl show "eurolify-$t.service" -p ExecMainExitTimestamp --value 2>/dev/null)"
done

seccao "contentores"
docker ps --all --format '{{.Names}}  {{.Status}}  {{.Image}}' 2>&1
docker stats --no-stream --format '{{.Name}}  {{.MemUsage}}' 2>&1

seccao "portas à escuta"
# Sem endereços (o filtro tirava-os todos e a secção saía vazia): diz só se a
# porta está presa a esta máquina ou aberta, e que programa a tem.
ss -tlnpH | awk '{
  n = split($4, p, ":"); porta = p[n]; endereco = substr($4, 1, length($4) - length(porta) - 1)
  if (endereco ~ /^(127\.|\[::1\])/) onde = "só nesta máquina"
  else if (endereco ~ /^(0\.0\.0\.0|\*|\[::\])$/) onde = "aberta (todas as interfaces)"
  else onde = "presa a um endereço"
  prog = "?"; if (match($0, /\(\("[^"]+"/)) prog = substr($0, RSTART + 3, RLENGTH - 4)
  printf "%s/tcp  %s  %s\n", porta, onde, prog
}' | sort -u | sort -t/ -k1,1n

seccao "ssh"
sshd -T 2>/dev/null | grep -E '^(passwordauthentication|kbdinteractiveauthentication|permitrootlogin|pubkeyauthentication) '

seccao "firewall"
ufw status verbose

seccao "fail2ban (só números)"
fail2ban-client status sshd 2>&1 | grep -E 'Currently|Total'
echo "bantime (sshd): $(fail2ban-client get sshd bantime 2>&1)"
echo "dbpurgeage: $(fail2ban-client get dbpurgeage 2>&1)"

seccao "MCP (ADR-0033)"
for c in /etc/letsencrypt/live/*/fullchain.pem; do
  [[ -r "$c" ]] && echo "certificado $(basename "$(dirname "$c")"): $(openssl x509 -enddate -noout -in "$c")"
done
[[ -r /etc/eurolify/ovh-dns.expira ]] && echo "chave da OVH (certificado) troca-se a: $(cat /etc/eurolify/ovh-dns.expira)"
curl -fsS -m 5 http://127.0.0.1:8090/health 2>/dev/null && echo || echo "MCP: /health sem resposta"

seccao "saída para o VIES (docs/23 §13)"
# Antes de ligar o VIES_URL (revisão do #244, P2-5): a máquina chega à API
# REST da Comissão? Só o estado do serviço, sem NIF nenhum.
if resposta="$(curl -fsS -m 10 -w '\nHTTP %{http_code} em %{time_total} s' \
  https://ec.europa.eu/taxation_customs/vies/rest-api/check-status 2>/dev/null)"; then
  echo "${resposta##*$'\n'}"
  if grep -q '"vow":{"available":true' <<<"$resposta"; then
    echo "VIES: disponível"
  else
    echo "VIES: responde, mas não diz que está disponível"
  fi
else
  echo "VIES: sem resposta (a máquina não chega à Comissão, ou o VIES está em baixo)"
fi
if grep -qs '^VIES_URL=.' /etc/eurolify/api.env; then
  echo "VIES_URL no api.env: sim (a consulta está ligada)"
else
  echo "VIES_URL no api.env: não (a consulta está desligada)"
fi

seccao "actualizações"
/usr/lib/update-notifier/apt-check --human-readable 2>&1
[[ -f /var/run/reboot-required ]] && echo "Reinício pedido pelas actualizações."

seccao "últimas publicações"
tail -n 5 /var/log/eurolify/publicacoes.log 2>/dev/null || echo "(nenhuma)"

seccao "migrações (base e versão no ar)"
# Sempre à vista, enquanto durar: a base à frente da versão no ar depois de
# voltar a uma publicação (tarefa #113; revisão do #115, P2-2).
if [[ -r /usr/local/lib/eurolify/comum.sh && -r /etc/eurolify/ensaio.conf ]]; then
  # shellcheck source=../lib/comum.sh
  source /usr/local/lib/eurolify/comum.sh
  # shellcheck source=/dev/null
  source /etc/eurolify/ensaio.conf
  mostrar_migracoes() {
    local no_ar da_base da_imagem="" rc=0 a_mais faltam
    no_ar="$(docker inspect --format '{{.Config.Image}}' eurolify-api 2>/dev/null)"
    [[ -n "$no_ar" ]] || { echo "sem a API no ar"; return; }
    da_base="$(migracoes_da_base)" || { echo "a base não respondeu"; return; }
    # Uma versão sem migrador não tem migrações: lista vazia, e a base à
    # frente vê-se na mesma (4.ª revisão do #115, P3-2).
    tem_migrador "$no_ar" || rc=$?
    if ((rc == 2)) || { ((rc == 0)) && ! da_imagem="$(migracoes_da_imagem "$no_ar")"; }; then
      echo "não se leu a lista de migrações da versão no ar"
      return
    fi
    echo "na base: $(printf '%s\n' "$da_base" | sed '/^$/d' | wc -l) (última: $(printf '%s\n' "$da_base" | tail -n 1))"
    echo "na versão no ar: $(printf '%s\n' "$da_imagem" | sed '/^$/d' | wc -l) (última: $(printf '%s\n' "$da_imagem" | tail -n 1))"
    a_mais="$(so_na_primeira "$da_base" "$da_imagem")"
    faltam="$(so_na_primeira "$da_imagem" "$da_base")"
    echo "na base e não na versão no ar: $(if [[ -n "$a_mais" ]]; then virgulas "$a_mais"; else echo nenhuma; fi)"
    echo "na versão no ar e não na base: $(if [[ -n "$faltam" ]]; then virgulas "$faltam"; else echo nenhuma; fi)"
  }
  mostrar_migracoes
else
  echo "(sem a configuração da máquina)"
fi

seccao "últimas acções registadas"
# A conta de quem pediu fica na máquina: esta saída vai para o MCP e para o
# GitHub Actions (revisão do #102, P2-1).
{ tail -n 15 /var/log/eurolify/acoes.log 2>/dev/null || echo "(nenhuma)"; } |
  sed -E 's/conta [0-9]+/conta <n>/g'

exit 0
