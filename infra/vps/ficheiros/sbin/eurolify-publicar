#!/usr/bin/env bash
# Publica no ensaio a imagem com o resumo dado (ADR-0026). Corre como root,
# chamado pelo eurolify-trabalho. Puxa pelo resumo, corre as migrações, troca
# o contentor, verifica o /health e volta à imagem anterior se falhar.
# Com --so-recriar (passo 10c do preparar.sh) só recria a API se ela já estiver
# nesta imagem e a ligação à base tiver mudado; nunca publica outra imagem.
# Com --emergencia (só root, à mão por SSH; infra/vps/LEIA-ME.md) volta a uma
# publicação mais antiga do que a imediatamente anterior: nunca migra uma base
# à frente da imagem, e fica registado como emergência.
set -Eeuo pipefail
# shellcheck source=../lib/comum.sh
source /usr/local/lib/eurolify/comum.sh

resumo="${1:-}"
[[ "$resumo" =~ ^sha256:[0-9a-f]{64}$ ]] || falhar "resumo de imagem inválido"

# Qualquer saída com erro fica no registo de acções, que o estado_do_ensaio
# mostra: pelo MCP a publicação corre em segundo plano, e o resto só ficava
# no diário da unidade (4.ª revisão do #115, P2-1). Também fecha a sessão no
# GHCR, se se abriu. Começa logo a seguir a validar o resumo, que é o que vai
# para o registo (5.ª revisão do #115, P3-2).
sessao_ghcr=0
# shellcheck disable=SC2317,SC2329 # chamada pelo trap EXIT (SC2317 no shellcheck 0.9 do CI)
ao_sair() {
  local rc=$?
  ((sessao_ghcr == 0)) || docker logout ghcr.io >/dev/null 2>&1 || true
  ((rc == 0)) || registar "publicação de $resumo terminou com erro (código $rc)"
}
trap ao_sair EXIT

so_recriar=0
emergencia=0
case "${2:-}" in
  "") ;;
  --so-recriar) so_recriar=1 ;;
  --emergencia) emergencia=1 ;;
  *) falhar "opção desconhecida: '${2}'" ;;
esac
carregar_config

# Uma publicação de cada vez, venha do fluxo publicar, do MCP ou do passo 10c
# do preparar.sh: cada fluxo só se trancava a si próprio, e dois a trocar o
# contentor ao mesmo tempo podiam deixar no ar uma imagem que nenhum dos dois
# disse ter publicado (revisão do #116, P2-1).
exec 8>/run/lock/eurolify-publicar.lock

flock -w 900 8 || falhar "outra publicação não acabou em 15 minutos"
((emergencia == 0)) || registar "EMERGÊNCIA: publicação de $resumo à mão, fora da regra da anterior (LEIA-ME)"

imagem="${IMAGEM_REPO}@${resumo}"
token=/etc/eurolify/ghcr.token
[[ -s "$token" ]] || falhar "falta $token (token clássico com read:packages, ADR-0026)"

# A ligação da API à base vive num ficheiro só dela, que o passo 10b do
# preparar.sh escreve inteiro; o api.env fica para o resto da configuração
# (revisão do #116, P2-3). Sem ele, a API corre só com as rotas públicas.
API_BASE_ENV=/etc/eurolify/api-base.env
base_env=()
[[ -f "$API_BASE_ENV" ]] && base_env=(--env-file "$API_BASE_ENV")
# A configuração do Hub (HUB_ORIGEM e PROXY_CONFIAVEL), que o passo 14 do
# preparar.sh escreve só com o site do Hub ligado (docs/22 §7). Vazio ou sem
# ele, as rotas do Hub não existem.
API_HUB_ENV=/etc/eurolify/api-hub.env
hub_env=()
[[ -f "$API_HUB_ENV" ]] && hub_env=(--env-file "$API_HUB_ENV")
# A chave dos segredos TOTP (TOTP_CHAVE), que o passo 10 do preparar.sh
# gera uma vez (docs/22 §9.2). Sem ela, a API corre sem a palavra-passe. Só se
# passa uma chave válida: uma estragada derrubava a API ao arrancar, sem volta
# atrás no --so-recriar (revisão do #177, P2-2 da VPS).
# A configuração do envio de e-mails (SMTP_*), que o eurolify-configurar
# escreve a partir dos segredos do ambiente «ensaio» (docs/34 §13). Sem ela,
# os e-mails ficam à espera na fila.
API_SMTP_ENV=/etc/eurolify/api-smtp.env
smtp_env=()
[[ -f "$API_SMTP_ENV" ]] && smtp_env=(--env-file "$API_SMTP_ENV")
# O endereço do VIES (VIES_URL), que o passo 10c do preparar.sh escreve
# (docs/23 §13). Sem ele, a consulta ao VIES fica desligada.
API_VIES_ENV=/etc/eurolify/api-vies.env
vies_env=()
[[ -f "$API_VIES_ENV" ]] && vies_env=(--env-file "$API_VIES_ENV")
API_TOTP_ENV=/etc/eurolify/api-totp.env
totp_env=()
if [[ -e "$API_TOTP_ENV" ]]; then
  # shellcheck source=../lib/chave-totp.sh
  if [[ -f /usr/local/lib/eurolify/chave-totp.sh ]] &&
    source /usr/local/lib/eurolify/chave-totp.sh &&
    chave_totp_valida "$API_TOTP_ENV"; then
    totp_env=(--env-file "$API_TOTP_ENV")
  else
    echo "AVISO: $API_TOTP_ENV não tem o formato esperado: a API arranca sem a palavra-passe."
    registar "chave TOTP inválida: a API arranca sem a palavra-passe"
  fi
fi

# A chave dos envios (ENVIOS_CHAVE), que o passo 10 do preparar.sh gera uma
# vez (docs/36 §17). Sem ela, a API corre sem os envios. Só se passa uma
# chave válida: uma estragada derrubava a API ao arrancar.
API_ENVIOS_ENV=/etc/eurolify/api-envios.env
envios_env=()
if [[ -e "$API_ENVIOS_ENV" ]]; then
  # shellcheck source=../lib/chave-envios.sh
  if [[ -f /usr/local/lib/eurolify/chave-envios.sh ]] &&
    source /usr/local/lib/eurolify/chave-envios.sh &&
    chave_envios_valida "$API_ENVIOS_ENV"; then
    envios_env=(--env-file "$API_ENVIOS_ENV")
  else
    echo "AVISO: $API_ENVIOS_ENV não tem o formato esperado: a API arranca sem os envios."
    registar "chave dos envios inválida: a API arranca sem os envios"
  fi
fi

# As imagens dos artigos ficam fora do contentor, na pasta da máquina
# (docs/06, CQ): sobrevivem a cada publicação. Com MEDIA_PASTA, a API liga as
# rotas da media.
arrancar() {
  # A pasta com o dono da API (o node da imagem, uid 1000): se faltar, cria-se
  # assim, e não como root pelo docker (revisão do #178, P1-2). O --mount
  # falha, em vez de a criar, se mesmo assim não existir.
  [[ -d /var/lib/eurolify/media ]] ||
    install -d -o 1000 -g 1000 -m 750 /var/lib/eurolify/media
  docker rm -f eurolify-api >/dev/null 2>&1 || true
  docker run -d --name eurolify-api \
    --restart unless-stopped \
    --network eurolify \
    -p 127.0.0.1:8080:8080 \
    --env-file /etc/eurolify/api.env \
    "${base_env[@]}" \
    "${hub_env[@]}" \
    "${totp_env[@]}" \
    "${envios_env[@]}" \
    "${smtp_env[@]}" \
    "${vies_env[@]}" \
    --mount type=bind,src=/var/lib/eurolify/media,dst=/media \
    -e MEDIA_PASTA=/media \
    --memory 512m \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
    "$1" >/dev/null
}

saude() {
  local porta="${1:-8080}" i
  for ((i = 0; i < 30; i++)); do
    if curl -fsS -m 2 "http://127.0.0.1:${porta}/health" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

# Com a ligação no api-base.env (passo 10b), a API tem de chegar à base. Uma
# chave inventada com a forma certa obriga-a a perguntar à base
# (chave_resolver): responde 401 se chegou, 500 se não (docs/19 §5, #107).
# Prova a ligação, não o papel: o 10b é que garante que a linha é a do
# eurolify_api (revisão do #116, P3-5). Uma imagem anterior ao #110 não tem
# /me (404): aí não há nada a provar (P2-2).
# Só se lê se a variável existe; o valor (com a palavra-passe) não sai daqui.
base_no_api_env() { grep -q '^BASE_DADOS_URL=' "$API_BASE_ENV" 2>/dev/null; }
printf -v CHAVE_INVENTADA 'eul_sk_%s' "$(printf 'a%.0s' {1..52})"
chega_a_base() {
  local i codigo=""
  for ((i = 0; i < 5; i++)); do
    codigo="$(curl -sS -m 5 -o /dev/null -w '%{http_code}' \
      -H "Authorization: Bearer $CHAVE_INVENTADA" http://127.0.0.1:8080/me 2>/dev/null || true)"
    [[ "$codigo" == 401 ]] && return 0
    [[ "$codigo" == 404 ]] && return 2
    sleep 2
  done
  echo "A API respondeu ${codigo:-nada} a uma chave inventada (esperava 401). Últimas linhas:"
  docker logs --tail 30 eurolify-api 2>&1 | filtrar_ip || true
  return 1
}
# Sem ligação no api.env, a API corre só com as rotas públicas: nada a provar.
# Com ela e sem chegar à base, falha sem voltar atrás: a imagem anterior
# usaria o mesmo api.env (o problema é a ligação, não a imagem).
verificar_base() {
  local rc=0
  base_no_api_env || return 0
  chega_a_base || rc=$?
  if ((rc == 0)); then
    echo "A API chega à base."
    return 0
  fi
  if ((rc == 2)); then
    echo "Esta imagem não tem o /me (anterior ao #110): não se prova a ligação à base."
    return 0
  fi
  registar "a API ($1) não chega à base com o api-base.env"
  echo "ATENÇÃO: a API não chega à base com a ligação do api-base.env."
  return 1
}

# O docker só lê o --env-file ao criar o contentor: se o api.env ou o
# api-base.env mudaram depois (o passo 10b do preparar.sh escreve a ligação),
# a API recria-se, mesmo com a imagem que já está no ar. Sem um número válido
# de um dos lados, não se compara (revisão do #116, P3-1).
api_env_mudou() {
  local criado ficheiro mudado
  criado="$(docker inspect -f '{{.Created}}' eurolify-api 2>/dev/null)" || return 1
  # A API no ar sem a pasta das imagens (criada antes do #178) recria-se:
  # senão, as imagens ficavam dentro do contentor e perdiam-se na publicação
  # seguinte (revisão do #178, P1-1).
  # Um inspect que falha não recria (como o de cima); a comparação é exacta.
  local montagens
  montagens="$(docker inspect -f '{{range .Mounts}}{{.Destination}} {{end}}' eurolify-api 2>/dev/null)" || return 1
  [[ " $montagens " == *" /media "* ]] || return 0
  # Em nanossegundos: em segundos, um ficheiro escrito no mesmo segundo em
  # que a API foi criada não contava (revisão do #160, P2-2).
  criado="$(date -d "$criado" +%s%N 2>/dev/null)" || return 1
  [[ "$criado" =~ ^[0-9]+$ ]] || return 1
  for ficheiro in /etc/eurolify/api.env "$API_BASE_ENV" "$API_HUB_ENV" "$API_TOTP_ENV" "$API_ENVIOS_ENV" "$API_SMTP_ENV" "$API_VIES_ENV"; do
    mudado="$(stat -c %.9Y "$ficheiro" 2>/dev/null)" || continue
    mudado="${mudado/./}"
    [[ "$mudado" =~ ^[0-9]+$ ]] && ((mudado > criado)) && return 0
  done
  return 1
}

# O MCP da VPS (ADR-0033) corre da mesma imagem: uma publicação actualiza os
# dois, e voltar atrás volta com os dois. Sem github-oauth.env não arranca.
# Uma falha do MCP não desfaz a publicação da API (revisão do #30): avisa, e a
# verificação diária também avisa.
mcp_configurado() { [[ -s /etc/eurolify/github-oauth.env ]] && id eurolify-mcp >/dev/null 2>&1; }
tem_mcp() { docker run --rm --entrypoint test "$1" -f /app/apps/mcp/dist/servidor.js >/dev/null 2>&1; }

# Põe o MCP na imagem dada; se não houver MCP nela, tira o contentor (senão
# ficava a reiniciar sem fim). Devolve 1 se o MCP devia estar no ar e não está.
mcp_para() {
  mcp_configurado || {
    echo "MCP: sem /etc/eurolify/github-oauth.env ou sem o utilizador eurolify-mcp; não arranca."
    return 0
  }
  if ! tem_mcp "$1"; then
    docker rm -f eurolify-mcp >/dev/null 2>&1 || true
    echo "MCP: esta imagem não tem o MCP; contentor tirado."
    return 0
  fi
  arrancar_mcp "$1"
  if saude 8090; then
    echo "MCP: arrancou e responde."
    return 0
  fi
  echo "ATENÇÃO: o MCP não respondeu no /health em 60 s (a API fica). Últimas linhas:"
  docker logs --tail 30 eurolify-mcp 2>&1 | filtrar_ip || true
  docker rm -f eurolify-mcp >/dev/null 2>&1 || true
  return 1
}

arrancar_mcp() {
  docker rm -f eurolify-mcp >/dev/null 2>&1 || true
  docker run -d --name eurolify-mcp \
    --restart unless-stopped \
    --pids-limit 100 \
    -p 127.0.0.1:8090:8090 \
    --user "$(id -u eurolify-mcp):$(id -g eurolify-mcp)" \
    -v /var/lib/eurolify/pedidos/mcp:/pedidos \
    --env-file /etc/eurolify/github-oauth.env \
    -e MCP_URL="$MCP_URL" -e CONTAS_PERMITIDAS="$MCP_CONTAS" \
    -e ANFITRIAO=0.0.0.0 -e PORTA=8090 -e PASTA_PEDIDOS=/pedidos \
    --workdir /app/apps/mcp \
    --memory 256m --cpus 1 \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --read-only --tmpfs /tmp \
    --no-healthcheck \
    --log-driver journald --log-opt tag=eurolify-mcp \
    "$1" node dist/servidor.js >/dev/null
}

# Os ecrãs do Hub (docs/22 §7) vêm na mesma imagem, em /app/hub: copiam-se
# para /var/lib/eurolify/hub/<resumo> e a ligação «actual», que o nginx serve,
# passa a apontar para lá de uma vez (mv -T). Voltar atrás volta também com os
# ecrãs. Uma falha aqui não desfaz a publicação da API (como o MCP): avisa.
# Ficam as 3 cópias mais recentes, contando a actual (revisão do #160, P3-6).
HUB_PASTA=/var/lib/eurolify/hub
tem_hub() { docker run --rm --network none --entrypoint test "$1" -f /app/hub/index.html >/dev/null 2>&1; }
pasta_hub() { echo "$HUB_PASTA/${1##*sha256:}"; }
hub_no_ar() { [[ "$(readlink "$HUB_PASTA/actual" 2>/dev/null || true)" == "$(pasta_hub "$1")" ]]; }
hub_para() {
  local destino tmp
  if ! tem_hub "$1"; then
    echo "Hub: esta imagem não tem os ecrãs do Hub."
    return 0
  fi
  destino="$(pasta_hub "$1")"
  # A função corre sempre numa condição, onde o set -e não vale: cada passo
  # devolve 1 se falhar (revisão do #160, P2-1).
  install -d -o root -g root -m 755 "$HUB_PASTA" || return 1
  # Restos de uma corrida interrompida (P3-6).
  find "$HUB_PASTA" -mindepth 1 -maxdepth 1 -name '.novo.*' -mmin +60 -exec rm -rf {} + 2>/dev/null || true
  if [[ ! -f "$destino/index.html" ]]; then
    tmp="$(mktemp -d "$HUB_PASTA/.novo.XXXXXX")" || return 1
    if ! docker run --rm --network none --entrypoint tar "$1" -C /app/hub -cf - . |
      tar -C "$tmp" --no-same-owner --no-same-permissions -xf - || [[ ! -f "$tmp/index.html" ]]; then
      rm -rf "$tmp"
      echo "ATENÇÃO: não se copiaram os ecrãs do Hub desta imagem (fica o que estava)."
      return 1
    fi
    if ! { chmod -R u=rwX,go=rX "$tmp" && rm -rf "$destino" && mv "$tmp" "$destino"; }; then
      rm -rf "$tmp"
      echo "ATENÇÃO: não se puseram os ecrãs do Hub no lugar (fica o que estava)."
      return 1
    fi
  fi
  if ! { ln -sfn "$destino" "$HUB_PASTA/.actual.novo" && mv -Tf "$HUB_PASTA/.actual.novo" "$HUB_PASTA/actual"; }; then
    rm -f "$HUB_PASTA/.actual.novo"
    echo "ATENÇÃO: não se trocou a ligação dos ecrãs do Hub (fica o que estava)."
    return 1
  fi
  local velha
  while IFS= read -r velha; do
    [[ "$velha" == "$destino" ]] || rm -rf "$velha"
  done < <(find "$HUB_PASTA" -mindepth 1 -maxdepth 1 -type d -name '[0-9a-f]*' -printf '%T@ %p\n' | sort -rn | tail -n +4 | cut -d' ' -f2-)
  echo "Hub: os ecrãs desta publicação estão no ar."
}

anterior="$(docker inspect --format '{{.Config.Image}}' eurolify-api 2>/dev/null || true)"
if ((so_recriar)) && [[ "$anterior" != "$imagem" ]]; then
  # Outra publicação trocou a imagem entretanto: essa já leu a ligação nova.
  echo "A API já não está em $resumo (está em ${anterior:-nenhuma}): não recrio."
  exit 0
fi

# Uma imagem que já está na máquina não se vai buscar outra vez: recriar não
# depende do GHCR (revisão do #116, P3-3). Pelo resumo, é a mesma imagem.
if docker image inspect "$imagem" >/dev/null 2>&1; then
  echo "A imagem $imagem já está na máquina."
else
  echo "A puxar $imagem"
  docker login ghcr.io -u "$GHCR_UTILIZADOR" --password-stdin <"$token" >/dev/null
  sessao_ghcr=1
  docker pull --quiet "$imagem" >/dev/null
fi
if [[ "$anterior" == "$imagem" ]]; then
  recriada=0
  if api_env_mudou; then
    echo "A API já está nesta imagem, mas a configuração (api.env, api-base.env, api-hub.env, api-totp.env, api-envios.env, api-smtp.env, api-vies.env ou a pasta das imagens) mudou depois de ela arrancar: recria-se."
    arrancar "$imagem"
    if ! saude 8080; then
      echo "O /health não respondeu em 60 s. Últimas linhas do contentor:"
      docker logs --tail 30 eurolify-api 2>&1 | filtrar_ip || true
      registar "API recriada com a configuração nova ($resumo), sem /health"
      falhar "a API não respondeu depois de ler a configuração nova"
    fi
    registar "API recriada com a configuração nova ($resumo)"
    echo "Recriada: $resumo. O /health da API responde."
    recriada=1
  fi
  # O MCP antes da prova da base: uma falha da base não o deixa por actualizar
  # (revisão do #116, P3-4).
  estado=0
  if mcp_configurado && [[ "$(docker inspect --format '{{.Config.Image}}' eurolify-mcp 2>/dev/null || true)" != "$imagem" ]]; then
    echo "A API já está nesta imagem; falta o MCP."
    mcp_para "$imagem" || { echo "o MCP não arrancou" >&2; estado=1; }
  # Um MCP de antes do #102 ainda escreve em ficheiros sem prazo: recria-se
  # para o diário do sistema (14 dias, ADR-0018, nota de 05/10/2026).
  elif mcp_configurado && docker inspect eurolify-mcp >/dev/null 2>&1 &&
    [[ "$(docker inspect --format '{{.HostConfig.LogConfig.Type}}' eurolify-mcp)" != journald ]]; then
    echo "A API já está nesta imagem; o MCP passa a escrever no diário do sistema."
    mcp_para "$imagem" || { echo "o MCP não arrancou" >&2; estado=1; }
  elif ((!recriada)) && (hub_no_ar "$imagem" || ! tem_hub "$imagem"); then
    echo "Esta imagem já é a que está no ar. Nada a fazer."
  fi
  if ! hub_no_ar "$imagem" && tem_hub "$imagem"; then
    echo "A API já está nesta imagem; faltam os ecrãs do Hub."
    if ! hub_para "$imagem"; then
      registar "$resumo: os ecrãs do Hub não ficaram no ar"
      estado=1
    fi
  fi
  if ((recriada)); then
    verificar_base "$resumo" || estado=1
  fi
  exit "$estado"
fi

# As migrações correm antes de trocar; se falharem, fica a versão anterior.
# Se o /health falhar depois, volta-se à imagem anterior com o esquema já
# migrado: por isso as migrações têm de ser compatíveis com a versão anterior
# (acrescentar primeiro, tirar só numa publicação seguinte). O migrador lê o
# migrar.env (a ligação do dono das tabelas), que a API nunca recebe.
#
# Antes de migrar, compara-se a base com a imagem (tarefa #113; a prova é a
# base, não o registo da máquina). O migrador recusa uma base com migrações
# que não conhece (Kysely: «corrupted migrations … is missing»), o que
# acontece ao voltar a uma publicação antiga (MCP, ADR-0033). Então, se a
# base tem migrações que a imagem não conhece:
# - também lhe falta alguma: recusa (a base e a imagem divergem);
# - só se volta à publicação imediatamente anterior à que está no ar, e só se
#   as migrações a mais forem todas das que a publicação no ar aplicou (o
#   «migrou» do publicacoes.log). As migrações são escritas para a versão
#   anterior no código; depois de voltas e correcções, a anterior no registo
#   pode não ser essa, e só o que a publicação no ar aplicou o prova (4.ª
#   revisão do #115, P2-2). Mais atrás é uma emergência (--emergencia). Não
#   se corre o migrador, e fica no registo;
# - de resto migra-se como sempre; se não se conseguir comparar, diz-se, e o
#   migrador decide (falha segura: fica a versão no ar); uma imagem sem
#   migrador que não se consegue comparar não se publica.
# Duas publicações não se cruzam: o cadeado do início (revisão do #116, P2-1)
# vale para a comparação, a migração e a troca do contentor.
recusar() {
  registar "publicação de $resumo recusada: $1"
  trap - EXIT
  ((sessao_ghcr == 0)) || docker logout ghcr.io >/dev/null 2>&1 || true
  falhar "$1; fica a versão no ar (${anterior:-nenhuma})"
}
migrar=0
rc=0
tem_migrador "$imagem" || rc=$?
((rc != 2)) || recusar "não se conseguiu ver se a imagem tem o migrador (erro do docker)"
com_migrador=$((rc == 0 ? 1 : 0))
da_imagem=""
lida=0
if ((com_migrador == 0)); then
  lida=1
elif da_imagem="$(migracoes_da_imagem "$imagem")"; then
  lida=1
fi
a_mais=""
migrou="?"
da_base=""
comparou=0
if ((lida == 1)) && da_base="$(migracoes_da_base)"; then
  comparou=1
  a_mais="$(so_na_primeira "$da_base" "$da_imagem")"
  faltam="$(so_na_primeira "$da_imagem" "$da_base")"
  if [[ -n "$a_mais" ]]; then
    [[ -z "$faltam" ]] ||
      recusar "a base tem migrações que esta imagem não conhece ($(virgulas "$a_mais")) e faltam-lhe outras ($(virgulas "$faltam"))"
    if ((emergencia == 0)); then
      [[ -n "$anterior" && "$(anterior_de "${anterior#*@}")" == "$imagem" ]] ||
        recusar "a base tem migrações que esta imagem não conhece ($(virgulas "$a_mais")) e ela não é a publicação imediatamente anterior à que está no ar"
      aplicadas="$(migrou_de "${anterior#*@}")" ||
        recusar "a publicação no ar não registou as migrações que aplicou: não se prova que as da base a mais ($(virgulas "$a_mais")) são só dela"
      fora="$(so_na_primeira "$a_mais" "$aplicadas")"
      [[ -z "$fora" ]] ||
        recusar "a base tem migrações que a publicação no ar não aplicou ($(virgulas "$fora")): a compatibilidade com esta imagem não está garantida"
    fi
    echo "Volta a uma publicação anterior: as migrações dela já estão na base; não se corre o migrador."
    registar "volta a $resumo: a base fica com migrações que esta versão não conhece ($(virgulas "$a_mais")); não se correu o migrador"
    migrou=""
  elif ((com_migrador == 1)); then
    migrar=1
    migrou="$faltam"
  else
    migrou=""
  fi
elif ((com_migrador == 1)); then
  echo "Não se comparou a base com a imagem (lista ilegível ou base sem resposta): migra-se como sempre, e o migrador decide."
  migrar=1
else
  recusar "imagem sem migrador e a base não respondeu: não se sabe se a base está à frente dela"
fi
# Avançar outra vez para uma imagem que já esteve no ar com esta mesma
# anterior: as migrações que ela aplicou da outra vez continuam a ser dela, se
# ainda estão na base (foram aplicadas com a mesma anterior no ar). Sem isto, o
# MCP só alternava uma vez (5.ª revisão do #115, P1-1).
# Também as de uma tentativa que falhou (linha «falhou»), que por sua vez já
# as tinha herdado (#122, P2-1).
herdadas=""
if ((comparou == 1)) && [[ -n "$anterior" && "$(anterior_de "$resumo")" == "$anterior" ]] &&
  antes="$(migrou_de "$resumo")"; then
  herdadas="$(em_ambas "$antes" "$da_base")"
  migrou="$(printf '%s\n%s\n' "$migrou" "$herdadas" | so_migracoes | uniq)"
fi
[[ "$migrou" == "?" ]] || migrou="$(virgulas "$migrou")"

# Uma linha no publicacoes.log. Uma tentativa que falhou também fica, marcada
# «falhou», com as migrações que deixou na base: ao repetir a mesma imagem com
# a mesma anterior, herda-as, e o MCP continua a poder voltar atrás (#120, P2).
linha_publicacao() { # linha_publicacao <marca extra ou vazio> <migrou>
  local marca=""
  ((emergencia == 0)) || marca=" | emergência"
  [[ -z "$1" ]] || marca="$marca | $1"
  printf '%s | %s | anterior: %s%s | migrou: %s\n' "$(date -u +%FT%TZ)" "$resumo" "${anterior:-nenhuma}" "$marca" "$2" >>/var/log/eurolify/publicacoes.log
}

if ((migrar == 1)); then
  echo "A correr as migrações"
  [[ -f /etc/eurolify/migrar.env ]] || falhar "falta /etc/eurolify/migrar.env (preparar.sh, passos 10 e 10b)"
  # As mesmas protecções da API: é o contentor com a ligação mais poderosa
  # (revisão do #43, P2-5 do 36e8778).
  docker run --rm --network eurolify --env-file /etc/eurolify/migrar.env \
    --memory 512m --cap-drop ALL --security-opt no-new-privileges \
    "$imagem" node dist/migrar.js || {
    # O que chegou a ficar na base, se se consegue ler (#120, P3-1).
    ficaram="?"
    if ((comparou == 1)) && depois="$(migracoes_da_base)"; then
      # As que esta tentativa deixou, mais as herdadas que ainda lá estão.
      ficaram="$(printf '%s\n%s\n' "$(so_na_primeira "$depois" "$da_base")" "$(em_ambas "$herdadas" "$depois")" | so_migracoes | uniq)"
      ficaram="$(virgulas "$ficaram")"
    fi
    linha_publicacao falhou "$ficaram"
    registar "a migração de $resumo falhou; ficaram na base: ${ficaram:-nenhuma}"
    falhar "a migração falhou: fica a versão anterior (${anterior:-nenhuma})"
  }
elif ((com_migrador == 0)) && [[ -z "$a_mais" ]]; then
  echo "Sem migrações nesta imagem."
fi

# Se a imagem nova nem arranca (o docker run falha), segue o mesmo caminho de
# um /health que não responde: linha «falhou» e volta à anterior (2.ª revisão
# do #122, P2-1).
arrancou=1
arrancar "$imagem" || arrancou=0
if ((arrancou == 1)) && saude 8080; then
  # A API nova já está no ar: uma falha a escrever não a deixa sem MCP
  # (3.ª revisão do #122, P3-B).
  estado=0
  if ! linha_publicacao "" "$migrou"; then
    echo "ATENÇÃO: não se escreveu a linha da publicação no publicacoes.log (o MCP não poderá voltar atrás)" >&2
    estado=1
  fi
  registar "publicado $resumo (anterior: ${anterior:-nenhuma})" || estado=1
  echo "Publicado: $resumo. O /health da API responde."
  # O MCP primeiro: uma API que não chega à base não deixa o MCP na imagem antiga.
  if ! mcp_para "$imagem"; then
    registar "publicado $resumo, mas o MCP não arrancou"
    estado=1
  fi
  if ! hub_para "$imagem"; then
    registar "publicado $resumo, mas os ecrãs do Hub não ficaram no ar"
    estado=1
  fi
  verificar_base "$resumo" || estado=1
  exit "$estado"
fi
if ((arrancou == 1)); then
  echo "O /health não respondeu em 60 s. Últimas linhas do contentor:"
  docker logs --tail 30 eurolify-api 2>&1 | filtrar_ip || true
else
  echo "A imagem nova não arrancou (docker run falhou)."
fi

# As migrações que esta publicação aplicou ficam na base: ficam numa linha
# «falhou» do publicacoes.log e no registo de acções (5.ª revisão do #115,
# P3-1; #120, P2), antes de voltar à anterior, que também pode falhar (#122,
# P2-2). Uma falha a escrever não impede a reposição (2.ª revisão do #122,
# P3-1).
linha_publicacao falhou "$migrou" || echo "ATENÇÃO: não se escreveu a linha «falhou» no publicacoes.log" >&2
registar "publicação de $resumo falhou no arranque ou no /health; migrou: ${migrou:-nenhuma}" || true

if [[ -n "$anterior" ]]; then
  echo "A voltar à imagem anterior: $anterior"
  if ! arrancar "$anterior"; then
    registar "ATENÇÃO: não se conseguiu arrancar a anterior ($anterior) depois de $resumo falhar"
    falhar "não se conseguiu arrancar a anterior ($anterior): a API está em baixo"
  fi
  mcp_para "$anterior" || true
  hub_para "$anterior" || true
  if saude 8080; then echo "A anterior voltou e responde."; else echo "ATENÇÃO: a anterior também não responde."; fi
else
  docker rm -f eurolify-api eurolify-mcp >/dev/null 2>&1 || true
  echo "ATENÇÃO: não havia publicação anterior para repor: a API está em baixo."
fi
registar "publicação de $resumo falhou; reposta: ${anterior:-nenhuma}"
exit 1
