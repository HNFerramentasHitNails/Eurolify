#!/usr/bin/env bash
# Publica no ensaio a imagem com o resumo dado (ADR-0026). Corre como root,
# chamado pelo eurolify-trabalho. Puxa pelo resumo, corre as migrações, troca
# o contentor, verifica o /health e volta à imagem anterior se falhar.
set -Eeuo pipefail
# shellcheck source=../lib/comum.sh
source /usr/local/lib/eurolify/comum.sh

resumo="${1:-}"
[[ "$resumo" =~ ^sha256:[0-9a-f]{64}$ ]] || falhar "resumo de imagem inválido"
carregar_config

imagem="${IMAGEM_REPO}@${resumo}"
token=/etc/eurolify/ghcr.token
[[ -s "$token" ]] || falhar "falta $token (token clássico com read:packages, ADR-0026)"

arrancar() {
  docker rm -f eurolify-api >/dev/null 2>&1 || true
  docker run -d --name eurolify-api \
    --restart unless-stopped \
    --network eurolify \
    -p 127.0.0.1:8080:8080 \
    --env-file /etc/eurolify/api.env \
    --memory 512m \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
    "$1" >/dev/null
}

saude() {
  local porta="${1:-8080}" i
  for ((i = 0; i < 30; i++)); do
    if curl -fsS -m 2 "http://127.0.0.1:${porta}/health" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

# O MCP da VPS (ADR-0033) corre da mesma imagem: uma publicação actualiza os
# dois, e voltar atrás volta com os dois. Sem github-oauth.env não arranca.
# Uma falha do MCP não desfaz a publicação da API (revisão do #30): avisa, e a
# verificação diária também avisa.
mcp_configurado() { [[ -s /etc/eurolify/github-oauth.env ]] && id eurolify-mcp >/dev/null 2>&1; }
tem_mcp() { docker run --rm --entrypoint test "$1" -f /app/apps/mcp/dist/servidor.js >/dev/null 2>&1; }

# Põe o MCP na imagem dada; se não houver MCP nela, tira o contentor (senão
# ficava a reiniciar sem fim). Devolve 1 se o MCP devia estar no ar e não está.
mcp_para() {
  mcp_configurado || {
    echo "MCP: sem /etc/eurolify/github-oauth.env ou sem o utilizador eurolify-mcp; não arranca."
    return 0
  }
  if ! tem_mcp "$1"; then
    docker rm -f eurolify-mcp >/dev/null 2>&1 || true
    echo "MCP: esta imagem não tem o MCP; contentor tirado."
    return 0
  fi
  arrancar_mcp "$1"
  if saude 8090; then
    echo "MCP: arrancou e responde."
    return 0
  fi
  echo "ATENÇÃO: o MCP não respondeu no /health em 60 s (a API fica). Últimas linhas:"
  docker logs --tail 30 eurolify-mcp 2>&1 | filtrar_ip || true
  docker rm -f eurolify-mcp >/dev/null 2>&1 || true
  return 1
}

arrancar_mcp() {
  docker rm -f eurolify-mcp >/dev/null 2>&1 || true
  docker run -d --name eurolify-mcp \
    --restart unless-stopped \
    --pids-limit 100 \
    -p 127.0.0.1:8090:8090 \
    --user "$(id -u eurolify-mcp):$(id -g eurolify-mcp)" \
    -v /var/lib/eurolify/pedidos/mcp:/pedidos \
    --env-file /etc/eurolify/github-oauth.env \
    -e MCP_URL="$MCP_URL" -e CONTAS_PERMITIDAS="$MCP_CONTAS" \
    -e ANFITRIAO=0.0.0.0 -e PORTA=8090 -e PASTA_PEDIDOS=/pedidos \
    --workdir /app/apps/mcp \
    --memory 256m --cpus 1 \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --read-only --tmpfs /tmp \
    --no-healthcheck \
    --log-driver journald --log-opt tag=eurolify-mcp \
    "$1" node dist/servidor.js >/dev/null
}

echo "A puxar $imagem"
docker login ghcr.io -u "$GHCR_UTILIZADOR" --password-stdin <"$token" >/dev/null
trap 'docker logout ghcr.io >/dev/null 2>&1 || true' EXIT
docker pull --quiet "$imagem" >/dev/null

anterior="$(docker inspect --format '{{.Config.Image}}' eurolify-api 2>/dev/null || true)"
if [[ "$anterior" == "$imagem" ]]; then
  if mcp_configurado && [[ "$(docker inspect --format '{{.Config.Image}}' eurolify-mcp 2>/dev/null || true)" != "$imagem" ]]; then
    echo "A API já está nesta imagem; falta o MCP."
    mcp_para "$imagem" || falhar "o MCP não arrancou"
    exit 0
  fi
  # Um MCP de antes do #102 ainda escreve em ficheiros sem prazo: recria-se
  # para o diário do sistema (14 dias, ADR-0018, nota de 05/10/2026).
  if mcp_configurado && docker inspect eurolify-mcp >/dev/null 2>&1 &&
    [[ "$(docker inspect --format '{{.HostConfig.LogConfig.Type}}' eurolify-mcp)" != journald ]]; then
    echo "A API já está nesta imagem; o MCP passa a escrever no diário do sistema."
    mcp_para "$imagem" || falhar "o MCP não arrancou"
    exit 0
  fi
  echo "Esta imagem já é a que está no ar. Nada a fazer."
  exit 0
fi

# As migrações correm antes de trocar; se falharem, fica a versão anterior.
# Se o /health falhar depois, volta-se à imagem anterior com o esquema já
# migrado: por isso as migrações têm de ser compatíveis com a versão anterior
# (acrescentar primeiro, tirar só numa publicação seguinte). O migrador lê o
# migrar.env (a ligação do dono das tabelas), que a API nunca recebe.
#
# Antes de migrar, compara-se a base com a imagem (tarefa #113; a prova é a
# base, não o registo da máquina). O migrador recusa uma base com migrações
# que não conhece (Kysely: «corrupted migrations … is missing»), o que
# acontece ao voltar a uma publicação antiga (MCP, ADR-0033). Então, se a
# base tem migrações que a imagem não conhece:
# - também lhe falta alguma: recusa (a base e a imagem divergem);
# - só se volta à publicação imediatamente anterior à que está no ar, e só se
#   as migrações a mais forem todas conhecidas da que está no ar: é a única
#   com a compatibilidade garantida (acrescentar primeiro, tirar depois).
#   Mais atrás é uma emergência, à mão e registada (decisão do Diogo,
#   06/10/2026, opção A da 2.ª revisão do #115). Não se migra, e fica no
#   registo;
# - de resto migra-se como sempre; se não se conseguir comparar, diz-se, e o
#   migrador decide (falha segura: fica a versão no ar).
# Duas publicações ao mesmo tempo (MCP e GitHub): se a base mudar entre a
# comparação e a migração, o migrador recusa e fica a versão no ar.
recusar() {
  registar "publicação de $resumo recusada: $1"
  falhar "$1; fica a versão no ar (${anterior:-nenhuma})"
}
migrar=0
tem_migrador=0
if docker run --rm --network none --cap-drop ALL --entrypoint test "$imagem" -f dist/migrar.js; then
  tem_migrador=1
fi
da_imagem=""
if ((tem_migrador == 1)); then
  da_imagem="$(migracoes_da_imagem "$imagem")" || da_imagem=""
fi
a_mais=""
if { ((tem_migrador == 0)) || [[ -n "$da_imagem" ]]; } && da_base="$(migracoes_da_base)"; then
  a_mais="$(so_na_primeira "$da_base" "$da_imagem")"
  faltam="$(so_na_primeira "$da_imagem" "$da_base")"
  if [[ -n "$a_mais" ]]; then
    [[ -z "$faltam" ]] ||
      recusar "a base tem migrações que esta imagem não conhece ($(virgulas "$a_mais")) e faltam-lhe outras ($(virgulas "$faltam"))"
    [[ -n "$anterior" && "$(anterior_de "${anterior#*@}")" == "$imagem" ]] ||
      recusar "a base tem migrações que esta imagem não conhece ($(virgulas "$a_mais")) e ela não é a publicação imediatamente anterior à que está no ar"
    desconhecidas="$(so_na_primeira "$a_mais" "$(migracoes_da_imagem "$anterior")")"
    [[ -z "$desconhecidas" ]] ||
      recusar "a base tem migrações que nem a versão no ar conhece ($(virgulas "$desconhecidas"))"
    echo "Volta à publicação anterior: as migrações dela já estão na base; não se migra."
    registar "volta a $resumo: a base fica com migrações que esta versão não conhece ($(virgulas "$a_mais")); não se migrou"
  elif ((tem_migrador == 1)); then
    migrar=1
  fi
elif ((tem_migrador == 1)); then
  echo "Não se comparou a base com a imagem (lista ilegível ou base sem resposta): migra-se como sempre, e o migrador decide."
  migrar=1
fi
if ((migrar == 1)); then
  echo "A correr as migrações"
  [[ -f /etc/eurolify/migrar.env ]] || falhar "falta /etc/eurolify/migrar.env (preparar.sh, passos 10 e 10b)"
  # As mesmas protecções da API: é o contentor com a ligação mais poderosa
  # (revisão do #43, P2-5 do 36e8778).
  docker run --rm --network eurolify --env-file /etc/eurolify/migrar.env \
    --memory 512m --cap-drop ALL --security-opt no-new-privileges \
    "$imagem" node dist/migrar.js ||
    falhar "a migração falhou: fica a versão anterior (${anterior:-nenhuma})"
elif ((tem_migrador == 0)) && [[ -z "$a_mais" ]]; then
  echo "Sem migrações nesta imagem."
fi

arrancar "$imagem"
if saude 8080; then
  printf '%s | %s | anterior: %s\n' "$(date -u +%FT%TZ)" "$resumo" "${anterior:-nenhuma}" >>/var/log/eurolify/publicacoes.log
  registar "publicado $resumo (anterior: ${anterior:-nenhuma})"
  echo "Publicado: $resumo. O /health da API responde."
  if ! mcp_para "$imagem"; then
    registar "publicado $resumo, mas o MCP não arrancou"
    exit 1
  fi
  exit 0
fi
echo "O /health não respondeu em 60 s. Últimas linhas do contentor:"
docker logs --tail 30 eurolify-api 2>&1 | filtrar_ip || true

if [[ -n "$anterior" ]]; then
  echo "A voltar à imagem anterior: $anterior"
  arrancar "$anterior"
  mcp_para "$anterior" || true
  if saude 8080; then echo "A anterior voltou e responde."; else echo "ATENÇÃO: a anterior também não responde."; fi
else
  docker rm -f eurolify-api eurolify-mcp >/dev/null 2>&1 || true
fi
registar "publicação de $resumo falhou; reposta: ${anterior:-nenhuma}"
exit 1
